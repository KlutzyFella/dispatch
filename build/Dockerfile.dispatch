# Stage 1: Build
FROM golang:1.23-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/
COPY gen/ gen/

RUN CGO_ENABLED=0 GOOS=linux go build -o /dispatch ./cmd/dispatch

# Stage 2: Runtime
FROM alpine:latest

RUN apk add --no-cache ca-certificates && \
    adduser -D -u 1000 appuser

COPY --from=builder /dispatch /dispatch

USER appuser

EXPOSE 50051 9090

ENTRYPOINT ["/dispatch"]
